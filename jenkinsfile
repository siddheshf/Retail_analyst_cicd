pipeline {
    agent any
    
    environment {
        LABS = credentials('labcreds')
        JAVA_HOME = '/opt/bitnami/java'  // Set your JAVA_HOME path here.
        PATH = "${env.JAVA_HOME}/bin:${env.PATH}"  // Add Java binaries to PATH
    }
    
    stages {
        stage('Deploy') {
            steps {
                echo "deploy completed successful"
            }
        }
        stage('Install Dependencies') {
            steps {
                echo "Dependecies installed"
            }
        }
        stage('Test') {
            steps {
                echo "Test phase"
            }
        }
        stage('Package') {
            steps {
                echo "In Package stage"
            }
        }
    }
}


